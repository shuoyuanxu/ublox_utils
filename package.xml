<?xml version="1.0"?>
<package format="2">
    <name>ublox_utils</name>
    <version>2.0.0</version>
    <description>
        RTK GNSS rover for a ZED-F9P taking corrections from a standalone
        ZED-F9P base over a 433 MHz radio link.
    </description>
    <author>Rik Bähnemann</author>
    <maintainer email="jjhshoppingregis@gmail.com">Shuoyuan</maintainer>

    <license>MIT</license>

    <buildtool_depend>catkin</buildtool_depend>

    <exec_depend>rospy</exec_depend>
    <exec_depend>std_msgs</exec_depend>
    <exec_depend>ublox_gps</exec_depend>
    <exec_depend>ublox_msgs</exec_depend>

</package>
